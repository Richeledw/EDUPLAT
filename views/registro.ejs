<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= datosRegistro.titulo %> - Eduplat</title>
    <meta name="description" content="Crea tu cuenta en Eduplat y comienza a aprender hoy mismo.">

    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome 6 CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- CSS personalizado -->
    <link rel="stylesheet" href="/css/styles.css">

    <style>
        * { box-sizing: border-box; }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
        }

        main { flex: 1; }

        /* ── Navbar ── */
        .navbar { background: rgba(255,255,255,0.12); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(255,255,255,0.2); }
        .navbar-brand { color: #fff !important; font-weight: 700; font-size: 1.3rem; }
        .nav-link { color: rgba(255,255,255,0.85) !important; transition: color .2s; }
        .nav-link:hover { color: #fff !important; }
        .nav-link.btn-outline-light { border-color: rgba(255,255,255,0.6); }
        .nav-link.btn-outline-light:hover { background: rgba(255,255,255,0.15); }

        /* ── Auth Card ── */
        .auth-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem 1rem;
            flex: 1;
        }

        .auth-card {
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 25px 60px rgba(0,0,0,0.2);
            width: 100%;
            max-width: 460px;
            padding: 2.5rem 2.5rem;
            animation: slideUp .4s ease;
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(20px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .auth-icon {
            width: 64px; height: 64px;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 1.2rem;
            font-size: 1.6rem; color: #fff;
        }

        .auth-title {
            font-size: 1.7rem; font-weight: 700;
            text-align: center; color: #111827; margin-bottom: .3rem;
        }

        .auth-subtitle {
            text-align: center; color: #6b7280;
            font-size: .93rem; margin-bottom: 1.8rem;
        }

        /* ── Form ── */
        .form-label { font-weight: 500; color: #374151; font-size: .9rem; }

        .form-control {
            border-radius: 10px;
            border: 1.5px solid #e5e7eb;
            padding: .65rem 1rem;
            transition: border-color .2s, box-shadow .2s;
            font-size: .95rem;
        }

        .form-control:focus {
            border-color: #8b5cf6;
            box-shadow: 0 0 0 3px rgba(139,92,246,.15);
        }

        .input-group-text {
            background: #f3f4f6; border: 1.5px solid #e5e7eb;
            border-right: none; border-radius: 10px 0 0 10px; color: #6b7280;
        }

        .input-group .form-control { border-left: none; border-radius: 0 10px 10px 0; }
        .input-group:focus-within .input-group-text { border-color: #8b5cf6; background: #ede9fe; color: #7c3aed; }

        /* ── Submit Button ── */
        .btn-registro {
            width: 100%; padding: .8rem;
            font-size: 1rem; font-weight: 600;
            border-radius: 10px; border: none;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            color: #fff;
            transition: opacity .2s, transform .15s;
            cursor: pointer;
            margin-top: .5rem;
        }

        .btn-registro:hover { opacity: .9; transform: translateY(-1px); }
        .btn-registro:active { transform: translateY(0); }

        /* ── Alerts ── */
        .alert { border-radius: 10px; font-size: .9rem; }

        /* ── Divider ── */
        .divider {
            display: flex; align-items: center; gap: .8rem;
            margin: 1.4rem 0; color: #9ca3af; font-size: .85rem;
        }
        .divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: #e5e7eb; }

        /* ── Footer ── */
        .auth-footer { text-align: center; font-size: .9rem; color: #6b7280; margin-top: 1.2rem; }
        .auth-footer a { color: #7c3aed; font-weight: 600; text-decoration: none; }
        .auth-footer a:hover { text-decoration: underline; }

        footer { background-color: #1f2937; color: white; }

        /* ── Rol Selector ── */
        .rol-selector {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: .6rem;
        }

        .rol-option input[type="radio"] { display: none; }

        .rol-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: .3rem;
            padding: .75rem .5rem;
            border: 2px solid #e5e7eb;
            border-radius: 12px;
            cursor: pointer;
            transition: border-color .2s, background .2s, transform .15s;
            text-align: center;
            background: #fafafa;
        }

        .rol-card i {
            font-size: 1.4rem;
            color: #9ca3af;
            transition: color .2s;
        }

        .rol-card strong { font-size: .82rem; color: #374151; }
        .rol-card small  { font-size: .72rem; color: #9ca3af; line-height: 1.2; }

        /* Estudiante activo → azul */
        #rol-estudiante:checked ~ .rol-card {
            border-color: #3b82f6; background: #eff6ff;
        }
        #rol-estudiante:checked ~ .rol-card i { color: #3b82f6; }

        /* Docente activo → verde */
        #rol-docente:checked ~ .rol-card {
            border-color: #10b981; background: #ecfdf5;
        }
        #rol-docente:checked ~ .rol-card i { color: #10b981; }

        /* Admin activo → violeta */
        #rol-admin:checked ~ .rol-card {
            border-color: #8b5cf6; background: #ede9fe;
        }
        #rol-admin:checked ~ .rol-card i { color: #8b5cf6; }

        .rol-card:hover { border-color: #8b5cf6; transform: translateY(-2px); }
    </style>
</head>

<body>

    <!-- Navbar -->
    <header>
        <nav class="navbar navbar-expand-md">
            <div class="container">
                <a class="navbar-brand" href="/">
                    <i class="fas fa-book-open me-2"></i>Eduplat
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon" style="filter:invert(1)"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto gap-2">
                        <li class="nav-item"><a class="nav-link" href="/">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" href="/temas">Cursos</a></li>
                        <li class="nav-item"><a class="nav-link" href="/contacto">Contacto</a></li>
                        <% if(locals.user) { %>
                            <li class="nav-item"><a class="nav-link" href="/panel">Mi Panel</a></li>
                        <% } else { %>
                            <li class="nav-item"><a class="nav-link btn btn-outline-light px-3" href="/login">Ingresar</a></li>
                        <% } %>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="auth-wrapper">
        <div class="auth-card">

            <!-- Ícono -->
            <div class="auth-icon">
                <i class="fas fa-user-plus"></i>
            </div>

            <h1 class="auth-title"><%= datosRegistro.titulo %></h1>
            <p class="auth-subtitle"><%= datosRegistro.descripcion %></p>

            <!-- Mensajes flash -->
            <% if(locals.success_msg && success_msg.length > 0) { %>
                <div class="alert alert-success d-flex align-items-center gap-2" role="alert">
                    <i class="fas fa-check-circle"></i> <%= success_msg %>
                </div>
            <% } %>

            <% if(locals.error_msg && error_msg.length > 0) { %>
                <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
                    <i class="fas fa-exclamation-circle"></i> <%= error_msg %>
                </div>
            <% } %>

            <!-- Errores de validación -->
            <% if(typeof errors !== 'undefined' && errors.length > 0) { %>
                <div class="alert alert-danger" role="alert">
                    <ul class="mb-0 ps-3">
                        <% errors.forEach(error => { %>
                            <li><%= error.msg %></li>
                        <% }) %>
                    </ul>
                </div>
            <% } %>

            <!-- Formulario -->
            <form id="form-registro" action="/registro" method="POST" novalidate>

                <!-- Nombre -->
                <div class="mb-3">
                    <label for="nombre" class="form-label">Nombre completo</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-user"></i></span>
                        <input
                            type="text"
                            id="nombre"
                            name="nombre"
                            class="form-control"
                            placeholder="Tu nombre"
                            value="<%= typeof nombre !== 'undefined' ? nombre : '' %>"
                            required
                            autocomplete="name"
                        >
                    </div>
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <label for="email" class="form-label">Correo electrónico</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            class="form-control"
                            placeholder="tu@email.com"
                            value="<%= typeof email !== 'undefined' ? email : '' %>"
                            required
                            autocomplete="email"
                        >
                    </div>
                </div>

                <!-- Contraseña -->
                <div class="mb-3">
                    <label for="password" class="form-label">Contraseña</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock"></i></span>
                        <input
                            type="password"
                            id="password"
                            name="password"
                            class="form-control"
                            placeholder="Mínimo 6 caracteres"
                            required
                            autocomplete="new-password"
                        >
                        <button class="btn btn-outline-secondary border-start-0" type="button" id="toggle-password" tabindex="-1" style="border-radius:0 10px 10px 0; border:1.5px solid #e5e7eb; border-left:none;">
                            <i class="fas fa-eye" id="eye-icon"></i>
                        </button>
                    </div>
                    <div class="form-text text-muted mt-1">Al menos 6 caracteres.</div>
                </div>

                <!-- Selección de Rol -->
                <div class="mb-3">
                    <label class="form-label">Tipo de cuenta</label>
                    <div class="rol-selector">
                        <label class="rol-option" id="rol-estudiante-label">
                            <input type="radio" name="rol" value="estudiante" id="rol-estudiante"
                                <%= (typeof rolSolicitado === 'undefined' || rolSolicitado === 'estudiante') ? 'checked' : '' %>>
                            <span class="rol-card">
                                <i class="fas fa-user-graduate"></i>
                                <strong>Estudiante</strong>
                                <small>Accede a cursos y sigue tu progreso</small>
                            </span>
                        </label>
                        <label class="rol-option" id="rol-docente-label">
                            <input type="radio" name="rol" value="docente" id="rol-docente"
                                <%= (typeof rolSolicitado !== 'undefined' && rolSolicitado === 'docente') ? 'checked' : '' %>>
                            <span class="rol-card">
                                <i class="fas fa-chalkboard-teacher"></i>
                                <strong>Docente</strong>
                                <small>Crea y gestiona tus cursos</small>
                            </span>
                        </label>
                        <label class="rol-option" id="rol-admin-label">
                            <input type="radio" name="rol" value="admin" id="rol-admin"
                                <%= (typeof rolSolicitado !== 'undefined' && rolSolicitado === 'admin') ? 'checked' : '' %>>
                            <span class="rol-card">
                                <i class="fas fa-shield-alt"></i>
                                <strong>Administrador</strong>
                                <small>Gestiona toda la plataforma</small>
                            </span>
                        </label>
                    </div>
                </div>

                <!-- Clave secreta (visible solo para docente/admin) -->
                <div class="mb-3" id="secret-field" style="display:none;">
                    <label for="rolSecret" class="form-label">
                        <i class="fas fa-key me-1"></i>Clave de acceso
                    </label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-key"></i></span>
                        <input
                            type="password"
                            id="rolSecret"
                            name="rolSecret"
                            class="form-control"
                            placeholder="Ingresa la clave de acceso"
                            autocomplete="off"
                        >
                    </div>
                    <div class="form-text text-muted mt-1">
                        <i class="fas fa-info-circle me-1"></i>
                        Solicita esta clave al administrador de la plataforma.
                    </div>
                </div>

                <button type="submit" class="btn-registro" id="btn-registro">
                    <i class="fas fa-rocket me-2"></i>Crear mi cuenta
                </button>
            </form>

            <div class="divider">o</div>

            <div class="auth-footer">
                ¿Ya tienes cuenta? <a href="/login">Inicia sesión aquí</a>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="py-4">
        <div class="container text-center">
            <p class="mb-0 small" style="color:rgba(255,255,255,0.6);">&copy; 2025 Eduplat. Todos los derechos reservados.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // ── Toggle mostrar/ocultar contraseña ────────────────────────────
        const toggleBtn = document.getElementById('toggle-password');
        const pwdInput  = document.getElementById('password');
        const eyeIcon   = document.getElementById('eye-icon');

        toggleBtn.addEventListener('click', () => {
            const visible = pwdInput.type === 'text';
            pwdInput.type = visible ? 'password' : 'text';
            eyeIcon.className = visible ? 'fas fa-eye' : 'fas fa-eye-slash';
        });

        // ── Selector de Rol: mostrar campo secreto ───────────────────────
        const secretField   = document.getElementById('secret-field');
        const rolSecretInput = document.getElementById('rolSecret');
        const rolRadios     = document.querySelectorAll('input[name="rol"]');

        function updateSecretField() {
            const selected = document.querySelector('input[name="rol"]:checked');
            const needsSecret = selected && (selected.value === 'docente' || selected.value === 'admin');
            secretField.style.display = needsSecret ? 'block' : 'none';
            rolSecretInput.required   = needsSecret;
        }

        rolRadios.forEach(r => r.addEventListener('change', updateSecretField));

        // Ejecutar al cargar para restaurar estado tras error de validación
        updateSecretField();

        // ── Efecto loading en el botón al enviar ─────────────────────────
        document.getElementById('form-registro').addEventListener('submit', function() {
            const btn = document.getElementById('btn-registro');
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Creando cuenta...';
            btn.disabled = true;
        });
    </script>
</body>

</html>
