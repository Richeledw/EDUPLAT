<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Panel - Eduplat</title>

    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome 6 CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- CSS personalizado -->
    <link rel="stylesheet" href="/css/styles.css">

    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background-color: #f9fafb;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        main {
            flex: 1;
        }

        .sidebar {
            background: white;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .sidebar-item {
            padding: 1rem 1.5rem;
            border-left: 3px solid transparent;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            color: #6b7280;
            display: block;
        }

        .sidebar-item:hover {
            background-color: #f3f4f6;
            color: #3b82f6;
            border-left-color: #3b82f6;
        }

        .sidebar-item.active {
            background-color: #eff6ff;
            color: #3b82f6;
            border-left-color: #3b82f6;
            font-weight: 600;
        }

        .header-panel {
            background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
            color: white;
            padding: 2rem 1rem;
        }

        .user-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
        }

        .card-curso {
            background: white;
            border: none;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
            height: 100%;
        }

        .card-curso:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15);
        }

        .course-image {
            height: 150px;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .course-image img {
            width: 80px;
            height: 80px;
        }

        .progress-bar-custom {
            background: linear-gradient(90deg, #3b82f6, #8b5cf6);
        }

        .stat-card {
            background: white;
            border-radius: 8px;
            padding: 1.5rem;
            text-align: center;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .stat-card .stat-number {
            font-size: 2rem;
            font-weight: 700;
            color: #3b82f6;
        }

        .stat-card .stat-label {
            color: #6b7280;
            font-size: 0.85rem;
        }

        footer {
            background-color: #1f2937;
            color: white;
            margin-top: 4rem;
        }
    </style>
</head>

<body>
    <!-- Header/Navbar -->
    <header class="bg-white shadow-sm sticky-top">
        <nav class="navbar navbar-expand-md navbar-light container-fluid">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand fw-bold fs-4 text-primary" href="/">
                    <i class="fas fa-book-open me-2"></i>
                    Eduplat
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto gap-2">
                        <li class="nav-item">
                            <a class="nav-link" href="/">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/temas">Cursos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" href="/panel">Mi Panel</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/contacto">Contacto</a>
                        </li>
                        <% if(locals.user) { %>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user me-2"></i><%= user.nombre %>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li><a class="dropdown-item" href="/panel"><i class="fas fa-tachometer-alt me-2"></i>Mi
                                            Panel</a></li>
                                    <li><a class="dropdown-item" href="/configuracion"><i class="fas fa-cog me-2"></i>Configuración</a>
                                    </li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li><a class="dropdown-item text-danger" href="/logout"><i
                                                class="fas fa-sign-out-alt me-2"></i>Cerrar Sesión</a></li>
                                </ul>
                            </li>
                            <% } %>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main>
        <!-- Header Panel -->
        <section class="header-panel">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <div class="user-avatar">
                            <i class="fas fa-user"></i>
                        </div>
                    </div>
                    <div class="col">
                        <h1 class="mb-1"><%= user.nombre %></h1>
                        <p class="mb-0"><%= user.email %></p>
                        <small>Miembro desde <%= new Date(user.creadoEn).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' }) %></small>
                    </div>
                    <div class="col-md-auto">
                        <a href="/configuracion" class="btn btn-outline-light">
                            <i class="fas fa-cog me-2"></i>Configuración
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Stats Section -->
        <section class="py-5">
            <div class="container">
                <div class="row g-4">
                    <div class="col-md-3">
                        <div class="stat-card">
                            <div class="stat-number"><%= totalCursos %></div>
                            <div class="stat-label">Cursos Inscritos</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="stat-card">
                            <div class="stat-number"><%= progresoPromedio %>%</div>
                            <div class="stat-label">Progreso Promedio</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="stat-card">
                            <div class="stat-number"><i class="fas fa-fire text-warning"></i></div>
                            <div class="stat-label"><%= Math.ceil(Math.random() * 10) %> Día Racha</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="stat-card">
                            <div class="stat-number"><i class="fas fa-trophy text-warning"></i></div>
                            <div class="stat-label"><%= Math.ceil(Math.random() * 5) %> Logros</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <div class="container py-5">
            <div class="row">
                <!-- Sidebar -->
                <div class="col-lg-3 mb-4">
                    <div class="sidebar">
                        <a href="/panel" class="sidebar-item active">
                            <i class="fas fa-tachometer-alt me-2"></i>
                            Mis Cursos
                        </a>
                        <a href="/configuracion" class="sidebar-item">
                            <i class="fas fa-cog me-2"></i>
                            Configuración
                        </a>
                        <a href="#certificados" class="sidebar-item">
                            <i class="fas fa-certificate me-2"></i>
                            Certificados
                        </a>
                        <a href="#logros" class="sidebar-item">
                            <i class="fas fa-star me-2"></i>
                            Logros
                        </a>
                        <a href="/contacto" class="sidebar-item">
                            <i class="fas fa-envelope me-2"></i>
                            Soporte
                        </a>
                    </div>
                </div>

                <!-- Main Content -->
                <div class="col-lg-9">
                    <!-- Mis Cursos -->
                    <div class="mb-5">
                        <h3 class="mb-4">
                            <i class="fas fa-book me-2"></i>Mis Cursos en Progreso
                        </h3>

                        <% if(cursosInscritos.length > 0) { %>
                            <div class="row g-4">
                                <% cursosInscritos.forEach(curso => { %>
                                    <div class="col-md-6 col-lg-4">
                                        <div class="card-curso">
                                            <div class="course-image">
                                                <img src="<%= curso.icono %>" alt="<%= curso.titulo %>">
                                            </div>
                                            <div class="p-3">
                                                <h5 class="card-title mb-2"><%= curso.titulo %></h5>
                                                <p class="text-muted small mb-3"><%= curso.descripcion.substring(0, 50) %>...</p>

                                                <div class="mb-3">
                                                    <div class="d-flex justify-content-between mb-2">
                                                        <small><strong>Progreso</strong></small>
                                                        <small><%= curso.progreso %>%</small>
                                                    </div>
                                                    <div class="progress" style="height: 6px;">
                                                        <div class="progress-bar progress-bar-custom" role="progressbar"
                                                            style="width: <%= curso.progreso %>%"></div>
                                                    </div>
                                                </div>

                                                <div class="text-muted small mb-3">
                                                    <i class="fas fa-book-open me-1"></i>
                                                    <%= curso.leccionesCompletadas %>/<%= curso.lecciones %> lecciones
                                                </div>

                                                <a href="/curso/<%= curso.id %>" class="btn btn-sm btn-primary w-100">
                                                    Continuar <i class="fas fa-arrow-right ms-2"></i>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                            <% } else { %>
                                <div class="alert alert-info" role="alert">
                                    <i class="fas fa-info-circle me-2"></i>
                                    No tienes cursos inscritos aún. <a href="/temas">Explora nuestros cursos</a>
                                </div>
                                <% } %>
                    </div>

                    <!-- Cursos Recomendados -->
                    <div class="mb-5">
                        <h3 class="mb-4">
                            <i class="fas fa-lightbulb me-2"></i>Cursos Recomendados Para Ti
                        </h3>
                        <div class="row g-4">
                            <div class="col-md-6 col-lg-4">
                                <div class="card-curso">
                                    <div class="course-image">
                                        <i class="fas fa-react fa-3x text-info"></i>
                                    </div>
                                    <div class="p-3">
                                        <h5 class="card-title">React Avanzado</h5>
                                        <p class="text-muted small">Domina React con hooks y components avanzados</p>
                                        <a href="/temas" class="btn btn-sm btn-outline-primary w-100">
                                            Inscribirse
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-4">
                                <div class="card-curso">
                                    <div class="course-image">
                                        <i class="fas fa-node fa-3x text-success"></i>
                                    </div>
                                    <div class="p-3">
                                        <h5 class="card-title">Node.js Backend</h5>
                                        <p class="text-muted small">Crea APIs RESTful con Node.js y Express</p>
                                        <a href="/temas" class="btn btn-sm btn-outline-primary w-100">
                                            Inscribirse
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-4">
                                <div class="card-curso">
                                    <div class="course-image">
                                        <i class="fas fa-database fa-3x text-danger"></i>
                                    </div>
                                    <div class="p-3">
                                        <h5 class="card-title">MongoDB Mastery</h5>
                                        <p class="text-muted small">Bases de datos NoSQL con MongoDB</p>
                                        <a href="/temas" class="btn btn-sm btn-outline-primary w-100">
                                            Inscribirse
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="py-5 bg-dark text-white">
        <div class="container">
            <div class="row">
                <div class="col-md-3 mb-4">
                    <h5 class="mb-3 text-white">Eduplat</h5>
                    <p class="text-white-75 small">Tu plataforma de aprendizaje en línea para dominar nuevas
                        habilidades.</p>
                </div>
                <div class="col-md-3 mb-4">
                    <h6 class="mb-3 text-white">Enlaces Rápidos</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="/" class="text-decoration-none text-white">Inicio</a></li>
                        <li class="mb-2"><a href="/temas" class="text-decoration-none text-white">Cursos</a></li>
                        <li><a href="/contacto" class="text-decoration-none text-white">Contacto</a></li>
                    </ul>
                </div>
                <div class="col-md-3 mb-4">
                    <h6 class="mb-3 text-white">Contáctanos</h6>
                    <p class="text-white-75 small mb-2">📧 info@eduplat.com</p>
                    <p class="text-white-75 small">📞 +54 9 1234567890</p>
                </div>
                <div class="col-md-3 mb-4">
                    <h6 class="mb-3 text-white">Síguenos</h6>
                    <div class="d-flex gap-2">
                        <a href="https://facebook.com" class="text-white" title="Facebook">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="https://instagram.com" class="text-white" title="Instagram">
                            <i class="fab fa-instagram"></i>
                        </a>
                        <a href="https://linkedin.com" class="text-white" title="LinkedIn">
                            <i class="fab fa-linkedin-in"></i>
                        </a>
                    </div>
                </div>
            </div>
            <hr class="bg-white-50">
            <div class="text-center text-white-75 small">
                <p>&copy; 2025 Eduplat - Plataforma de Aprendizaje. Todos los derechos reservados.</p>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
