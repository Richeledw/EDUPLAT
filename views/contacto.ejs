<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= datosContacto.titulo %> - Eduplat</title>
    
    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome 6 CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- CSS personalizado -->
    <link rel="stylesheet" href="/css/styles.css">
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            background-color: #f9fafb;
        }
        main { flex: 1; }

        .header-contacto {
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            color: white;
            padding: 3rem 1rem;
            text-align: center;
        }

        .header-contacto h1 {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .contact-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
            margin: 3rem 0;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-label {
            font-weight: 500;
            color: #111827;
            margin-bottom: 0.5rem;
        }

        .form-control {
            border: 1px solid #d1d5db;
            border-radius: 5px;
            padding: 0.75rem;
        }

        .form-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }

        textarea.form-control {
            resize: vertical;
            min-height: 150px;
        }

        .btn-enviar {
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            border: none;
            color: white;
            font-weight: 600;
            padding: 0.75rem 2rem;
            border-radius: 5px;
        }

        .btn-enviar:hover {
            background: linear-gradient(135deg, #2563eb, #7c3aed);
            color: white;
        }

        .contact-info {
            background: white;
            border-radius: 8px;
            padding: 2rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .info-item {
            display: flex;
            align-items: flex-start;
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .info-item:last-child {
            margin-bottom: 0;
        }

        .info-icon {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            flex-shrink: 0;
        }

        .info-content h6 {
            font-weight: 600;
            color: #111827;
            margin-bottom: 0.25rem;
        }

        .info-content p {
            color: #6b7280;
            margin-bottom: 0;
        }

        .alert-success {
            background-color: #d1fae5;
            border-color: #6ee7b7;
            color: #065f46;
        }

        @media (max-width: 768px) {
            .contact-grid {
                grid-template-columns: 1fr;
            }
        }

        footer {
            background-color: #1f2937;
            color: white;
            margin-top: 4rem;
        }
    </style>
</head>
<body>
    <!-- Header/Navbar -->
    <header class="bg-white shadow-sm sticky-top">
        <nav class="navbar navbar-expand-md navbar-light container-fluid">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand fw-bold fs-4 text-primary" href="/">
                    <i class="fas fa-book-open me-2"></i>
                    Eduplat
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto gap-2">
                        <li class="nav-item">
                            <a class="nav-link" href="/">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/temas">Cursos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" href="/contacto">Contacto</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link btn btn-primary text-white px-3" href="/registro">Registrarse</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main>
        <!-- Header Section -->
        <div class="header-contacto">
            <div class="container">
                <h1><%= datosContacto.titulo %></h1>
                <p class="lead mb-0"><%= datosContacto.descripcion %></p>
            </div>
        </div>

        <!-- Contact Section -->
        <section class="py-5">
            <div class="container">
                <% if(typeof mensaje_exito !== 'undefined' && mensaje_exito) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle me-2"></i>
                        <%= mensaje_exito %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <div class="contact-grid">
                    <!-- Formulario de Contacto -->
                    <div>
                        <h3 class="mb-4">Envíanos un Mensaje</h3>
                        <form action="/contacto" method="POST">
                            <!-- Nombre -->
                            <div class="form-group">
                                <label for="nombre" class="form-label">Nombre Completo</label>
                                <input 
                                    type="text" 
                                    class="form-control" 
                                    id="nombre" 
                                    name="nombre"
                                    placeholder="Tu nombre"
                                    required
                                >
                            </div>

                            <!-- Email -->
                            <div class="form-group">
                                <label for="email" class="form-label">Correo Electrónico</label>
                                <input 
                                    type="email" 
                                    class="form-control" 
                                    id="email" 
                                    name="email"
                                    placeholder="tu@email.com"
                                    required
                                >
                            </div>

                            <!-- Asunto -->
                            <div class="form-group">
                                <label for="asunto" class="form-label">Asunto</label>
                                <input 
                                    type="text" 
                                    class="form-control" 
                                    id="asunto" 
                                    name="asunto"
                                    placeholder="¿En qué podemos ayudarte?"
                                    required
                                >
                            </div>

                            <!-- Mensaje -->
                            <div class="form-group">
                                <label for="mensaje" class="form-label">Mensaje</label>
                                <textarea 
                                    class="form-control" 
                                    id="mensaje" 
                                    name="mensaje"
                                    placeholder="Cuéntanos con detalle..."
                                    required
                                ></textarea>
                            </div>

                            <button type="submit" class="btn btn-enviar">
                                <i class="fas fa-paper-plane me-2"></i>
                                Enviar Mensaje
                            </button>
                        </form>
                    </div>

                    <!-- Información de Contacto -->
                    <div class="contact-info">
                        <h3 class="mb-4">Información de Contacto</h3>

                        <!-- Email -->
                        <div class="info-item">
                            <div class="info-icon">
                                <i class="fas fa-envelope"></i>
                            </div>
                            <div class="info-content">
                                <h6>Correo Electrónico</h6>
                                <p><a href="mailto:<%= datosContacto.email %>" class="text-decoration-none"><%= datosContacto.email %></a></p>
                            </div>
                        </div>

                        <!-- Teléfono -->
                        <div class="info-item">
                            <div class="info-icon">
                                <i class="fas fa-phone"></i>
                            </div>
                            <div class="info-content">
                                <h6>Teléfono</h6>
                                <p><a href="tel:<%= datosContacto.telefono %>" class="text-decoration-none"><%= datosContacto.telefono %></a></p>
                            </div>
                        </div>

                        <!-- Ubicación -->
                        <div class="info-item">
                            <div class="info-icon">
                                <i class="fas fa-map-marker-alt"></i>
                            </div>
                            <div class="info-content">
                                <h6>Ubicación</h6>
                                <p><%= datosContacto.ubicacion %></p>
                            </div>
                        </div>

                        <!-- Horarios -->
                        <div class="info-item">
                            <div class="info-icon">
                                <i class="fas fa-clock"></i>
                            </div>
                            <div class="info-content">
                                <h6>Horarios de Atención</h6>
                                <p>Lunes a Viernes: 09:00 - 18:00<br>Sábados: 10:00 - 14:00</p>
                            </div>
                        </div>

                        <!-- Redes Sociales -->
                        <h6 class="mt-4 mb-3">Síguenos en Redes Sociales</h6>
                        <div class="d-flex gap-2">
                            <a href="https://facebook.com" class="btn btn-outline-primary btn-sm">
                                <i class="fab fa-facebook-f"></i>
                            </a>
                            <a href="https://instagram.com" class="btn btn-outline-primary btn-sm">
                                <i class="fab fa-instagram"></i>
                            </a>
                            <a href="https://linkedin.com" class="btn btn-outline-primary btn-sm">
                                <i class="fab fa-linkedin-in"></i>
                            </a>
                            <a href="https://twitter.com" class="btn btn-outline-primary btn-sm">
                                <i class="fab fa-x-twitter"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="py-5 bg-dark text-white" style="margin-top: 4rem;">
        <div class="container">
            <div class="row">
                <div class="col-md-3 mb-4">
                    <h5 class="mb-3 text-white">Eduplat</h5>
                    <p class="text-white-75 small">Tu plataforma de aprendizaje en línea para dominar nuevas habilidades.</p>
                </div>
                <div class="col-md-3 mb-4">
                    <h6 class="mb-3 text-white">Enlaces Rápidos</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="/" class="text-decoration-none text-white">Inicio</a></li>
                        <li class="mb-2"><a href="/temas" class="text-decoration-none text-white">Cursos</a></li>
                        <li><a href="/contacto" class="text-decoration-none text-white">Contacto</a></li>
                    </ul>
                </div>
                <div class="col-md-3 mb-4">
                    <h6 class="mb-3 text-white">Contáctanos</h6>
                    <p class="text-white-75 small mb-2">📧 <%= datosContacto.email %></p>
                    <p class="text-white-75 small">📞 <%= datosContacto.telefono %></p>
                </div>
                <div class="col-md-3 mb-4">
                    <h6 class="mb-3 text-white">Síguenos</h6>
                    <div class="d-flex gap-2">
                        <a href="https://facebook.com" class="text-white" title="Facebook">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="https://instagram.com" class="text-white" title="Instagram">
                            <i class="fab fa-instagram"></i>
                        </a>
                        <a href="https://linkedin.com" class="text-white" title="LinkedIn">
                            <i class="fab fa-linkedin-in"></i>
                        </a>
                    </div>
                </div>
            </div>
            <hr class="bg-white-50">
            <div class="text-center text-white-75 small">
                <p>&copy; 2025 Eduplat - Plataforma de Aprendizaje. Todos los derechos reservados.</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
