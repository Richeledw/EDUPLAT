<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= titlePage %> - Eduplat</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">

    <style>
        * { box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: #f9fafb; color: #1f2937; min-height: 100vh; }
        .sidebar { width: 260px; background: #ffffff; border-right: 1px solid #e5e7eb; min-height: 100vh; padding: 1.5rem 1rem; position: fixed; top: 0; left: 0; display: flex; flex-direction: column; z-index: 100; }
        .sidebar-brand { display: flex; align-items: center; gap: .75rem; padding: .5rem .5rem 1.25rem; border-bottom: 1px solid #f3f4f6; margin-bottom: 1.25rem; text-decoration: none; }
        .sidebar-brand .brand-icon { width: 40px; height: 40px; background: linear-gradient(135deg, #3b82f6, #8b5cf6); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; color: #fff; }
        .sidebar-brand span { color: #111827; font-weight: 700; font-size: 1.15rem; }
        .sidebar-brand small { color: #6b7280; font-size: .75rem; display: block; font-weight: 500; }
        .nav-section-label { font-size: .7rem; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; color: #9ca3af; padding: 0 .75rem; margin: .75rem 0 .35rem; }
        .sidebar .nav-link { display: flex; align-items: center; gap: .75rem; padding: .65rem .75rem; border-radius: 8px; color: #4b5563; font-size: .88rem; font-weight: 500; text-decoration: none; margin-bottom: .2rem; }
        .sidebar .nav-link:hover { background: #f3f4f6; color: #1d4ed8; }
        .sidebar .nav-link.active { background: #eff6ff; color: #2563eb; font-weight: 600; border-left: 3px solid #3b82f6; }
        .sidebar .nav-link i { width: 18px; text-align: center; }
        .sidebar-footer { margin-top: auto; padding-top: 1rem; border-top: 1px solid #e5e7eb; }
        .sidebar-footer .user-info { padding: .5rem; background: #f9fafb; border-radius: 8px; margin-bottom: .5rem; }

        .main-content { margin-left: 260px; padding: 2rem; min-height: 100vh; }
        .topbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem; }
        .topbar h1 { font-size: 1.6rem; font-weight: 700; color: #111827; margin: 0; }
        .breadcrumb { font-size: .85rem; color: #6b7280; margin: 0; }
        .breadcrumb span.active { color: #2563eb; font-weight: 500; }

        .table-container { background: #ffffff; border: 1px solid #e5e7eb; border-radius: 14px; box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05); overflow: hidden; }
        .tc-header { padding: 1.2rem 1.5rem; border-bottom: 1px solid #e5e7eb; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }
        .table thead th { background: #f9fafb; color: #6b7280; font-size: .75rem; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; border-bottom: 1px solid #e5e7eb; padding: .85rem 1.25rem; }
        .table tbody td { color: #4b5563; border-bottom: 1px solid #f3f4f6; padding: .95rem 1.25rem; font-size: .88rem; }
    </style>
</head>

<body>
    <!-- ── SIDEBAR ── -->
    <%- include('../partials/admin-sidebar', { activeTab: 'proyectos' }) %>

    <!-- ── MAIN CONTENT ── -->
    <main class="main-content">
        <div class="topbar">
            <div>
                <h1><i class="fas fa-laptop-code me-2 text-primary"></i><%= titlePage %></h1>
                <nav class="breadcrumb mt-1">
                    <a href="/admin/dashboard" style="color:#6b7280;text-decoration:none;">Dashboard</a>
                    &nbsp;/&nbsp; <span class="active">Proyectos Prácticos</span>
                </nav>
            </div>
            <span class="badge bg-primary px-3 py-2 fw-semibold">Workspace Global</span>
        </div>

        <!-- Flash Messages -->
        <% if(locals.success_msg && success_msg.length > 0) { %>
            <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                <i class="fas fa-check-circle me-2"></i><%= success_msg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>
        <% if(locals.error_msg && error_msg.length > 0) { %>
            <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i><%= error_msg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <div class="table-container">
            <div class="tc-header">
                <div>
                    <h5 class="fw-bold text-dark mb-0"><i class="fas fa-tasks text-primary me-2"></i>Entregas de Proyectos de Estudiantes (<%= proyectos.length %>)</h5>
                    <small class="text-muted">Revisión de bitácoras, repositorios y calificaciones</small>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-borderless align-middle">
                    <thead>
                        <tr>
                            <th>Estudiante</th>
                            <th>Curso</th>
                            <th>Proyecto</th>
                            <th>Enlaces</th>
                            <th>Estado</th>
                            <th>Último Avance</th>
                            <th class="text-end">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(proyectos && proyectos.length > 0) { %>
                            <% proyectos.forEach(p => { %>
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark"><%= p.estudianteNombre %></div>
                                        <small class="text-muted"><%= p.estudianteEmail %></small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-primary border"><%= p.cursoTitulo || p.cursoId %></span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark"><%= p.titulo %></div>
                                        <% if(p.descripcion) { %>
                                            <small class="text-muted text-truncate d-block" style="max-width:200px;"><%= p.descripcion %></small>
                                        <% } %>
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <% if(p.repositorioUrl) { %>
                                                <a href="<%= p.repositorioUrl %>" target="_blank" class="btn btn-sm btn-outline-dark py-0 px-2" title="Repositorio">
                                                    <i class="fab fa-github"></i>
                                                </a>
                                            <% } %>
                                            <% if(p.despliegueUrl) { %>
                                                <a href="<%= p.despliegueUrl %>" target="_blank" class="btn btn-sm btn-outline-primary py-0 px-2" title="Demo en vivo">
                                                    <i class="fas fa-globe"></i>
                                                </a>
                                            <% } %>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge <%= p.estado === 'Completado' ? 'bg-success' : (p.estado === 'En Revisión' ? 'bg-warning text-dark' : 'bg-secondary') %>">
                                            <%= p.estado %>
                                        </span>
                                    </td>
                                    <td><%= new Date(p.actualizadoEn).toLocaleDateString('es-CO') %></td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-primary fw-semibold"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalRetroalimentar"
                                                data-id="<%= p._id %>"
                                                data-estudiante="<%= p.estudianteNombre %>"
                                                data-titulo="<%= p.titulo %>"
                                                data-notas="<%= p.notasAvance || '' %>"
                                                data-estado="<%= p.estado %>">
                                            <i class="fas fa-comment-dots me-1"></i> Calificar / Feedback
                                        </button>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    Aún no hay entregas de proyectos registradas.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <!-- Modal Retroalimentar Proyecto -->
    <div class="modal fade" id="modalRetroalimentar" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold text-dark"><i class="fas fa-comment-dots text-primary me-2"></i>Calificar y Dejar Feedback</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="formRetroalimentar" method="POST">
                    <div class="modal-body">
                        <div class="p-3 bg-light rounded mb-3 border">
                            <span class="text-muted small d-block">Estudiante:</span>
                            <strong class="text-dark" id="modal-estudiante-nombre"></strong>
                            <div class="small text-muted mt-1" id="modal-proyecto-titulo"></div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark">Bitácora del Alumno</label>
                            <div class="p-2 bg-light border rounded small text-secondary" id="modal-notas-avance" style="max-height:100px;overflow-y:auto;"></div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark">Nuevo Estado del Proyecto</label>
                            <select name="estado" id="modal-estado-select" class="form-select">
                                <option value="En Progreso">🟡 En Progreso (Requiere más trabajo)</option>
                                <option value="En Revisión">🔵 En Revisión</option>
                                <option value="Completado">🟢 Completado y Aprobado</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark">Calificación (0 - 100)</label>
                            <input type="number" name="calificacion" class="form-control" min="0" max="100" placeholder="Ej: 95">
                        </div>

                        <div class="mb-2">
                            <label class="form-label fw-semibold text-dark">Comentarios de Retroalimentación</label>
                            <textarea name="comentario" class="form-control" rows="3" placeholder="Escribe tus observaciones y recomendaciones al estudiante..." required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-top">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary fw-semibold px-4" style="background:linear-gradient(135deg,#3b82f6,#8b5cf6);border:none;">Enviar Retroalimentación</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const modalRetro = document.getElementById('modalRetroalimentar');
        modalRetro.addEventListener('show.bs.modal', (event) => {
            const btn = event.relatedTarget;
            document.getElementById('modal-estudiante-nombre').textContent = btn.dataset.estudiante;
            document.getElementById('modal-proyecto-titulo').textContent = btn.dataset.titulo;
            document.getElementById('modal-notas-avance').textContent = btn.dataset.notas || 'Sin notas de bitácora registradas.';
            document.getElementById('modal-estado-select').value = btn.dataset.estado;
            document.getElementById('formRetroalimentar').action = `/admin/proyectos/${btn.dataset.id}/retroalimentar`;
        });
    </script>
</body>
</html>
