<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Configuración - Eduplat</title>

    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome 6 CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- CSS personalizado -->
    <link rel="stylesheet" href="/css/styles.css">

    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background-color: #f9fafb;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        main {
            flex: 1;
        }

        .settings-container {
            background: white;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .settings-section {
            border-bottom: 1px solid #e5e7eb;
            padding: 2rem;
        }

        .settings-section:last-child {
            border-bottom: none;
        }

        .settings-section h3 {
            font-size: 1.3rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
            color: #111827;
        }

        .form-label {
            font-weight: 500;
            margin-bottom: 0.5rem;
        }

        .nav-tabs .nav-link {
            color: #6b7280;
            border: none;
            border-bottom: 3px solid transparent;
            padding: 0.75rem 1.5rem;
        }

        .nav-tabs .nav-link.active {
            color: #3b82f6;
            border-bottom-color: #3b82f6;
        }

        .nav-tabs .nav-link:hover {
            color: #3b82f6;
        }

        footer {
            background-color: #1f2937;
            color: white;
            margin-top: 4rem;
        }

        .danger-zone {
            background-color: #fee2e2;
            padding: 1.5rem;
            border-radius: 8px;
            border: 1px solid #fecaca;
        }

        .danger-zone h5 {
            color: #991b1b;
            margin-bottom: 1rem;
        }
    </style>
</head>

<body>
    <!-- Header/Navbar -->
    <header class="bg-white shadow-sm sticky-top">
        <nav class="navbar navbar-expand-md navbar-light container-fluid">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand fw-bold fs-4 text-primary" href="/">
                    <i class="fas fa-book-open me-2"></i>
                    Eduplat
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto gap-2">
                        <li class="nav-item">
                            <a class="nav-link" href="/">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/temas">Cursos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/panel">Mi Panel</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/contacto">Contacto</a>
                        </li>
                        <% if(locals.user) { %>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user me-1"></i><%= user.nombre %>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li><a class="dropdown-item" href="/panel"><i class="fas fa-tachometer-alt me-2"></i>Mi
                                            Panel</a></li>
                                    <li><a class="dropdown-item active" href="/configuracion"><i class="fas fa-cog me-2"></i>Configuración</a>
                                    </li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li><a class="dropdown-item text-danger" href="/logout"><i
                                                class="fas fa-sign-out-alt me-2"></i>Cerrar Sesión</a></li>
                                </ul>
                            </li>
                            <% } %>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main>
        <!-- Page Header -->
        <div class="bg-light py-4 border-bottom">
            <div class="container">
                <h1 class="h3 mb-0">
                    <i class="fas fa-cog me-2"></i>Configuración
                </h1>
            </div>
        </div>

        <!-- Settings Content -->
        <div class="container py-5">
            <div class="row">
                <div class="col-lg-3 mb-4">
                    <!-- Sidebar Menu -->
                    <div class="list-group">
                        <a href="#perfil" class="list-group-item list-group-item-action active" data-bs-toggle="list"
                            role="tab">
                            <i class="fas fa-user me-2"></i>
                            Perfil
                        </a>
                        <a href="#seguridad" class="list-group-item list-group-item-action" data-bs-toggle="list"
                            role="tab">
                            <i class="fas fa-lock me-2"></i>
                            Seguridad
                        </a>
                        <a href="#notificaciones" class="list-group-item list-group-item-action" data-bs-toggle="list"
                            role="tab">
                            <i class="fas fa-bell me-2"></i>
                            Notificaciones
                        </a>
                        <a href="#privacidad" class="list-group-item list-group-item-action" data-bs-toggle="list"
                            role="tab">
                            <i class="fas fa-eye-slash me-2"></i>
                            Privacidad
                        </a>
                    </div>
                </div>

                <div class="col-lg-9">
                    <div class="settings-container">
                        <!-- Perfil Section -->
                        <div class="settings-section" id="perfil">
                            <h3><i class="fas fa-user me-2"></i>Información del Perfil</h3>

                            <form>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label for="nombre" class="form-label">Nombre Completo</label>
                                        <input type="text" class="form-control" id="nombre" value="<%= user.nombre %>"
                                            disabled>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="email" class="form-label">Email</label>
                                        <input type="email" class="form-control" id="email" value="<%= user.email %>"
                                            disabled>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label for="telefono" class="form-label">Teléfono</label>
                                        <input type="tel" class="form-control" id="telefono" placeholder="+54 9 1234567890">
                                    </div>
                                    <div class="col-md-6">
                                        <label for="ciudad" class="form-label">Ciudad</label>
                                        <input type="text" class="form-control" id="ciudad" placeholder="Buenos Aires">
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label for="bio" class="form-label">Biografía</label>
                                    <textarea class="form-control" id="bio" rows="4"
                                        placeholder="Cuéntanos un poco sobre ti..."></textarea>
                                </div>

                                <button type="button" class="btn btn-primary" onclick="alert('Función no implementada aún')">
                                    <i class="fas fa-save me-2"></i>Guardar Cambios
                                </button>
                            </form>
                        </div>

                        <!-- Seguridad Section -->
                        <div class="settings-section" id="seguridad" style="display:none;">
                            <h3><i class="fas fa-lock me-2"></i>Seguridad</h3>

                            <div class="mb-4">
                                <h5>Cambiar Contraseña</h5>
                                <form>
                                    <div class="mb-3">
                                        <label for="passwordActual" class="form-label">Contraseña Actual</label>
                                        <input type="password" class="form-control" id="passwordActual"
                                            placeholder="Ingresa tu contraseña actual">
                                    </div>
                                    <div class="mb-3">
                                        <label for="passwordNueva" class="form-label">Nueva Contraseña</label>
                                        <input type="password" class="form-control" id="passwordNueva"
                                            placeholder="Ingresa una nueva contraseña">
                                    </div>
                                    <div class="mb-3">
                                        <label for="passwordConfirmar" class="form-label">Confirmar Contraseña</label>
                                        <input type="password" class="form-control" id="passwordConfirmar"
                                            placeholder="Confirma tu nueva contraseña">
                                    </div>
                                    <button type="button" class="btn btn-primary"
                                        onclick="alert('Función no implementada aún')">
                                        Cambiar Contraseña
                                    </button>
                                </form>
                            </div>

                            <hr>

                            <div>
                                <h5>Sesiones Activas</h5>
                                <p class="text-muted">Gestiona tus sesiones activas en diferentes dispositivos</p>
                                <div class="list-group">
                                    <div class="list-group-item">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <i class="fas fa-desktop me-2"></i>
                                                <strong>Windows - Chrome</strong>
                                                <br>
                                                <small class="text-muted">Sesión actual</small>
                                            </div>
                                            <span class="badge bg-success">Activa</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Notificaciones Section -->
                        <div class="settings-section" id="notificaciones" style="display:none;">
                            <h3><i class="fas fa-bell me-2"></i>Notificaciones</h3>

                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="emailNotificaciones" checked>
                                <label class="form-check-label" for="emailNotificaciones">
                                    Recibir notificaciones por email
                                </label>
                            </div>

                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="emailNewCursos" checked>
                                <label class="form-check-label" for="emailNewCursos">
                                    Notificarme sobre nuevos cursos
                                </label>
                            </div>

                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="emailPromos" checked>
                                <label class="form-check-label" for="emailPromos">
                                    Recibir ofertas y promociones
                                </label>
                            </div>

                            <button type="button" class="btn btn-primary"
                                onclick="alert('Función no implementada aún')">
                                Guardar Preferencias
                            </button>
                        </div>

                        <!-- Privacidad Section -->
                        <div class="settings-section" id="privacidad" style="display:none;">
                            <h3><i class="fas fa-eye-slash me-2"></i>Privacidad</h3>

                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="perfilPublico">
                                <label class="form-check-label" for="perfilPublico">
                                    Hacer mi perfil público
                                </label>
                            </div>

                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="mostrarProgreso">
                                <label class="form-check-label" for="mostrarProgreso">
                                    Mostrar mi progreso en cursos
                                </label>
                            </div>

                            <div class="form-check form-switch mb-4">
                                <input class="form-check-input" type="checkbox" id="permitirMensajes">
                                <label class="form-check-label" for="permitirMensajes">
                                    Permitir mensajes de otros usuarios
                                </label>
                            </div>

                            <button type="button" class="btn btn-primary"
                                onclick="alert('Función no implementada aún')">
                                Guardar Configuración
                            </button>

                            <hr style="margin-top: 3rem;">

                            <div class="danger-zone">
                                <h5><i class="fas fa-exclamation-triangle me-2"></i>Zona de Peligro</h5>
                                <p class="text-muted small mb-3">Las siguientes acciones no se pueden deshacer. Por favor,
                                    procede con cuidado.</p>
                                <button type="button" class="btn btn-danger"
                                    onclick="if(confirm('¿Estás seguro de que quieres eliminar tu cuenta? Esta acción no se puede deshacer.')) alert('Función no implementada aún')">
                                    <i class="fas fa-trash me-2"></i>Eliminar Mi Cuenta
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="py-5 bg-dark text-white">
        <div class="container">
            <div class="row">
                <div class="col-md-3 mb-4">
                    <h5 class="mb-3 text-white">Eduplat</h5>
                    <p class="text-white-75 small">Tu plataforma de aprendizaje en línea para dominar nuevas
                        habilidades.</p>
                </div>
                <div class="col-md-3 mb-4">
                    <h6 class="mb-3 text-white">Enlaces Rápidos</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="/" class="text-decoration-none text-white">Inicio</a></li>
                        <li class="mb-2"><a href="/temas" class="text-decoration-none text-white">Cursos</a></li>
                        <li><a href="/contacto" class="text-decoration-none text-white">Contacto</a></li>
                    </ul>
                </div>
                <div class="col-md-3 mb-4">
                    <h6 class="mb-3 text-white">Contáctanos</h6>
                    <p class="text-white-75 small mb-2">📧 info@eduplat.com</p>
                    <p class="text-white-75 small">📞 +54 9 1234567890</p>
                </div>
                <div class="col-md-3 mb-4">
                    <h6 class="mb-3 text-white">Síguenos</h6>
                    <div class="d-flex gap-2">
                        <a href="https://facebook.com" class="text-white" title="Facebook">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="https://instagram.com" class="text-white" title="Instagram">
                            <i class="fab fa-instagram"></i>
                        </a>
                        <a href="https://linkedin.com" class="text-white" title="LinkedIn">
                            <i class="fab fa-linkedin-in"></i>
                        </a>
                    </div>
                </div>
            </div>
            <hr class="bg-white-50">
            <div class="text-center text-white-75 small">
                <p>&copy; 2025 Eduplat - Plataforma de Aprendizaje. Todos los derechos reservados.</p>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Handle sidebar menu clicks
        document.querySelectorAll('.list-group-item').forEach(item => {
            item.addEventListener('click', function (e) {
                e.preventDefault();
                
                // Remove active class from all items
                document.querySelectorAll('.list-group-item').forEach(i => i.classList.remove('active'));
                
                // Add active class to clicked item
                this.classList.add('active');
                
                // Hide all sections
                document.querySelectorAll('.settings-section').forEach(section => {
                    section.style.display = 'none';
                });
                
                // Show selected section
                const target = this.getAttribute('href');
                document.querySelector(target).style.display = 'block';
            });
        });
    </script>
</body>

</html>
