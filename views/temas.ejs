<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= datosTemas.titulo %> - Eduplat
    </title>

    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome 6 CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- CSS personalizado -->
    <link rel="stylesheet" href="/css/styles.css">

    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            background-color: #f9fafb;
        }

        main {
            flex: 1;
        }

        .header-temas {
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            color: white;
            padding: 3rem 1rem;
            text-align: center;
        }

        .header-temas h1 {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .course-card {
            background: white;
            border: none;
            border-radius: 8px;
            overflow: hidden;
            transition: all 0.3s ease;
            height: 100%;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .course-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15);
        }

        .course-image {
            height: 180px;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .course-image img {
            width: 100px;
            height: 100px;
        }

        .course-body {
            padding: 1.5rem;
        }

        .course-title {
            font-weight: 600;
            font-size: 1.1rem;
            margin-bottom: 0.5rem;
            color: #111827;
        }

        .course-desc {
            font-size: 0.9rem;
            color: #6b7280;
            margin-bottom: 1rem;
        }

        .course-meta {
            display: flex;
            justify-content: space-between;
            font-size: 0.85rem;
            color: #6b7280;
            margin-bottom: 1rem;
        }

        .course-level {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .level-beginner {
            background-color: #d1fae5;
            color: #065f46;
        }

        .level-intermediate {
            background-color: #fef3c7;
            color: #92400e;
        }

        .level-advanced {
            background-color: #fee2e2;
            color: #7f1d1d;
        }

        .course-link {
            text-decoration: none;
            color: inherit;
            display: block;
        }

        .course-link:hover {
            color: inherit;
        }

        footer {
            background-color: #1f2937;
            color: white;
            margin-top: 4rem;
        }
    </style>
</head>

<body>
    <!-- Header/Navbar -->
    <%- include('partials/navbar') %>

    <main>
        <!-- Header Section -->
        <div class="header-temas">
            <div class="container">
                <h1>
                    <%= datosTemas.titulo %>
                </h1>
                <p class="lead mb-0">
                    <%= datosTemas.descripcion %>
                </p>
            </div>
        </div>

        <!-- Courses Grid -->
        <section class="py-5">
            <div class="container">
                <div class="row g-4">
                    <% datosTemas.cursos.forEach(curso=> { %>
                        <div class="col-md-6 col-lg-4">
                            <a href="/curso/<%= curso.id %>" class="course-link">
                                <div class="course-card">
                                    <div class="course-image">
                                        <!-- Logo SVG con respaldo de Font Awesome -->
                                        <% let imagenExiste=false; let fontAwesomeIcon='fa-book'; 
                                           /* Mapeo de iconos de Font Awesome 6 como respaldo */
                                           const iconMap={ 'html' : { icon: 'fa-html5' , color: 'text-danger' }, 'css' : { icon: 'fa-css3-alt' , color: 'text-info' }, 'javascript' : { icon: 'fa-js' , color: 'text-warning' }, 'python' : { icon: 'fa-python' , color: 'text-primary' }, 'sql' : { icon: 'fa-database' , color: 'text-danger' }, 'typescript' : { icon: 'fa-code' , color: 'text-secondary' } }; 
                                           const iconInfo=iconMap[curso.id] || { icon: 'fa-book' , color: 'text-primary' }; 
                                           fontAwesomeIcon=`fa-solid ${iconInfo.icon}`; %>
                                            <img src="<%= curso.icono %>" alt="<%= curso.titulo %>"
                                                style="max-width: 80px; max-height: 80px;"
                                                onerror="this.parentElement.className += ' fallback-icon'; this.display='none';">
                                            <i class="fas <%= fontAwesomeIcon %> fa-3x" style="display:none;"></i>
                                    </div>
                                    <div class="course-body">
                                        <h5 class="course-title">
                                            <%= curso.titulo %>
                                        </h5>
                                        <p class="course-desc">
                                            <%= curso.descripcion.substring(0, 60) %>...
                                        </p>

                                        <div class="course-meta">
                                            <span>
                                                <i class="fas fa-star text-warning"></i>
                                                <%= curso.calificacion %> (<%= curso.resenas %>)
                                            </span>
                                            <span class="course-level level-<%= curso.nivel.toLowerCase() %>">
                                                <%= curso.nivel %>
                                            </span>
                                        </div>

                                        <div class="d-flex justify-content-between text-muted small">
                                            <span><i class="fas fa-clock me-1"></i>
                                                <%= curso.duracion %>
                                            </span>
                                            <span><i class="fas fa-book me-1"></i>
                                                <%= curso.lecciones %> lecciones
                                            </span>
                                        </div>

                                        <% if (datosTemas.inscritosIds && datosTemas.inscritosIds.includes(curso.id)) { %>
                                            <a href="/curso/<%= curso.id %>/aula" class="btn btn-sm btn-success mt-3 w-100 fw-semibold">
                                                <i class="fas fa-laptop-code me-1"></i> Continuar Aprendiendo
                                            </a>
                                        <% } else { %>
                                            <a href="/curso/<%= curso.id %>" class="btn btn-sm btn-primary mt-3 w-100 fw-semibold">
                                                Ver Curso & Inscribirse <i class="fas fa-arrow-right ms-2"></i>
                                            </a>
                                        <% } %>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <% }); %>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="py-5 bg-dark text-white" style="margin-top: 4rem;">
        <div class="container">
            <div class="row">
                <div class="col-md-3 mb-4">
                    <h5 class="mb-3 text-white">Eduplat</h5>
                    <p class="text-white-75 small">Tu plataforma de aprendizaje en línea para dominar nuevas
                        habilidades.</p>
                </div>
                <div class="col-md-3 mb-4">
                    <h6 class="mb-3 text-white">Enlaces Rápidos</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="/" class="text-decoration-none text-white">Inicio</a></li>
                        <li class="mb-2"><a href="/temas" class="text-decoration-none text-white">Cursos</a></li>
                        <li><a href="/contacto" class="text-decoration-none text-white">Contacto</a></li>
                    </ul>
                </div>
                <div class="col-md-3 mb-4">
                    <h6 class="mb-3 text-white">Contáctanos</h6>
                    <p class="text-white-75 small mb-2">📧 info@eduplat.com</p>
                    <p class="text-white-75 small">📞 +54 9 1234567890</p>
                </div>
                <div class="col-md-3 mb-4">
                    <h6 class="mb-3 text-white">Síguenos</h6>
                    <div class="d-flex gap-2">
                        <a href="https://facebook.com" class="text-white" title="Facebook">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="https://instagram.com" class="text-white" title="Instagram">
                            <i class="fab fa-instagram"></i>
                        </a>
                        <a href="https://linkedin.com" class="text-white" title="LinkedIn">
                            <i class="fab fa-linkedin-in"></i>
                        </a>
                    </div>
                </div>
            </div>
            <hr class="bg-white-50">
            <div class="text-center text-white-75 small">
                <p>&copy; 2025 Eduplat - Plataforma de Aprendizaje. Todos los derechos reservados.</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>