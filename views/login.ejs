<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= datosLogin.titulo %> - Eduplat</title>
    <meta name="description" content="Inicia sesión en Eduplat y accede a todos tus cursos y progreso.">

    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome 6 CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- CSS personalizado -->
    <link rel="stylesheet" href="/css/styles.css">

    <style>
        * { box-sizing: border-box; }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
        }

        main { flex: 1; }

        /* ── Navbar ── */
        .navbar { background: rgba(255,255,255,0.12); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(255,255,255,0.2); }
        .navbar-brand { color: #fff !important; font-weight: 700; font-size: 1.3rem; }
        .nav-link { color: rgba(255,255,255,0.85) !important; transition: color .2s; }
        .nav-link:hover { color: #fff !important; }
        .nav-link.btn-primary { background: #fff !important; color: #7c3aed !important; font-weight: 600; border: none; }
        .nav-link.btn-primary:hover { opacity: .9; }

        /* ── Auth Card ── */
        .auth-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem 1rem;
            flex: 1;
        }

        .auth-card {
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 25px 60px rgba(0,0,0,0.2);
            width: 100%;
            max-width: 440px;
            padding: 2.5rem 2.5rem;
            animation: slideUp .4s ease;
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(20px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .auth-icon {
            width: 64px; height: 64px;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 1.2rem;
            font-size: 1.6rem; color: #fff;
        }

        .auth-title {
            font-size: 1.7rem; font-weight: 700;
            text-align: center; color: #111827; margin-bottom: .3rem;
        }

        .auth-subtitle {
            text-align: center; color: #6b7280;
            font-size: .93rem; margin-bottom: 1.8rem;
        }

        /* ── Form ── */
        .form-label { font-weight: 500; color: #374151; font-size: .9rem; }

        .form-control {
            border-radius: 10px;
            border: 1.5px solid #e5e7eb;
            padding: .65rem 1rem;
            transition: border-color .2s, box-shadow .2s;
            font-size: .95rem;
        }

        .form-control:focus {
            border-color: #8b5cf6;
            box-shadow: 0 0 0 3px rgba(139,92,246,.15);
        }

        .input-group-text {
            background: #f3f4f6; border: 1.5px solid #e5e7eb;
            border-right: none; border-radius: 10px 0 0 10px; color: #6b7280;
        }

        .input-group .form-control { border-left: none; border-radius: 0 10px 10px 0; }
        .input-group:focus-within .input-group-text { border-color: #8b5cf6; background: #ede9fe; color: #7c3aed; }

        /* ── Submit Button ── */
        .btn-login {
            width: 100%; padding: .8rem;
            font-size: 1rem; font-weight: 600;
            border-radius: 10px; border: none;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            color: #fff;
            transition: opacity .2s, transform .15s;
            cursor: pointer;
            margin-top: .5rem;
        }

        .btn-login:hover { opacity: .9; transform: translateY(-1px); }
        .btn-login:active { transform: translateY(0); }

        /* ── Alerts ── */
        .alert { border-radius: 10px; font-size: .9rem; }

        /* ── Forgot password ── */
        .forgot-link { font-size: .85rem; color: #7c3aed; text-decoration: none; }
        .forgot-link:hover { text-decoration: underline; }

        /* ── Divider ── */
        .divider {
            display: flex; align-items: center; gap: .8rem;
            margin: 1.4rem 0; color: #9ca3af; font-size: .85rem;
        }
        .divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: #e5e7eb; }

        /* ── Footer link ── */
        .auth-footer { text-align: center; font-size: .9rem; color: #6b7280; margin-top: 1.2rem; }
        .auth-footer a { color: #7c3aed; font-weight: 600; text-decoration: none; }
        .auth-footer a:hover { text-decoration: underline; }

        footer { background-color: #1f2937; color: white; }
    </style>
</head>

<body>

    <!-- Navbar -->
    <header>
        <nav class="navbar navbar-expand-md">
            <div class="container">
                <a class="navbar-brand" href="/">
                    <i class="fas fa-book-open me-2"></i>Eduplat
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon" style="filter:invert(1)"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto gap-2">
                        <li class="nav-item"><a class="nav-link" href="/">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" href="/temas">Cursos</a></li>
                        <li class="nav-item"><a class="nav-link" href="/contacto">Contacto</a></li>
                        <% if(locals.user) { %>
                            <li class="nav-item"><a class="nav-link" href="/panel">Mi Panel</a></li>
                        <% } else { %>
                            <li class="nav-item"><a class="nav-link btn btn-primary px-3" href="/registro">Registrarse</a></li>
                        <% } %>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="auth-wrapper">
        <div class="auth-card">

            <!-- Ícono -->
            <div class="auth-icon">
                <i class="fas fa-sign-in-alt"></i>
            </div>

            <h1 class="auth-title"><%= datosLogin.titulo %></h1>
            <p class="auth-subtitle"><%= datosLogin.descripcion %></p>

            <!-- Mensajes flash -->
            <% if(locals.success_msg && success_msg.length > 0) { %>
                <div class="alert alert-success d-flex align-items-center gap-2" role="alert">
                    <i class="fas fa-check-circle"></i> <%= success_msg %>
                </div>
            <% } %>

            <% if(locals.error_msg && error_msg.length > 0) { %>
                <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
                    <i class="fas fa-exclamation-circle"></i> <%= error_msg %>
                </div>
            <% } %>

            <% if(locals.error && error.length > 0) { %>
                <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
                    <i class="fas fa-exclamation-circle"></i> <%= error %>
                </div>
            <% } %>

            <!-- Formulario -->
            <form id="form-login" action="/login" method="POST" novalidate>

                <!-- Email -->
                <div class="mb-3">
                    <label for="email" class="form-label">Correo electrónico</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            class="form-control"
                            placeholder="tu@email.com"
                            required
                            autocomplete="email"
                        >
                    </div>
                </div>

                <!-- Contraseña -->
                <div class="mb-2">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label for="password" class="form-label mb-0">Contraseña</label>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock"></i></span>
                        <input
                            type="password"
                            id="password"
                            name="password"
                            class="form-control"
                            placeholder="Tu contraseña"
                            required
                            autocomplete="current-password"
                        >
                        <button class="btn btn-outline-secondary border-start-0" type="button" id="toggle-password" tabindex="-1" style="border-radius:0 10px 10px 0; border:1.5px solid #e5e7eb; border-left:none;">
                            <i class="fas fa-eye" id="eye-icon"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn-login" id="btn-login">
                    <i class="fas fa-sign-in-alt me-2"></i>Iniciar sesión
                </button>
            </form>

            <div class="divider">o</div>

            <div class="auth-footer">
                ¿No tienes cuenta? <a href="/registro">Regístrate gratis</a>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="py-4">
        <div class="container text-center">
            <p class="mb-0 small" style="color:rgba(255,255,255,0.6);">&copy; 2025 Eduplat. Todos los derechos reservados.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Toggle mostrar/ocultar contraseña
        const toggleBtn = document.getElementById('toggle-password');
        const pwdInput  = document.getElementById('password');
        const eyeIcon   = document.getElementById('eye-icon');

        toggleBtn.addEventListener('click', () => {
            const visible = pwdInput.type === 'text';
            pwdInput.type = visible ? 'password' : 'text';
            eyeIcon.className = visible ? 'fas fa-eye' : 'fas fa-eye-slash';
        });

        // Efecto loading en el botón al enviar
        document.getElementById('form-login').addEventListener('submit', function() {
            const btn = document.getElementById('btn-login');
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Ingresando...';
            btn.disabled = true;
        });
    </script>
</body>

</html>
